# Copy this file to .env and fill in real values before running.
# Never commit the real .env file to git.

# Postgres connection string. On Railway, add a Postgres service to your
# project and Railway provides this automatically (usually as ${{Postgres.DATABASE_URL}}
# if you reference it, or you can copy the value directly). For local
# development, point this at a local Postgres instance, e.g.:
#   postgresql://postgres:yourpassword@localhost:5432/grv_dev
DATABASE_URL=

# How many simultaneous database connections this app can hold open. Default
# is 20, which real load testing showed comfortably handles 300 concurrent
# requests (3x a 100-customer target) with zero failures. Increase if you
# scale well past that and start seeing connection queueing under load.
DB_POOL_MAX=20

# Set to "false" only if connecting to a local Postgres without SSL. Leave
# unset/default for Railway and other hosted Postgres, which require it.
PGSSL=

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Your own developer/owner login (My Business dashboard, admin PIN recovery,
# etc.) - this is created automatically on first run, but you choose the
# credentials. No default is shipped, since a hardcoded default password is a
# real security risk in a real deployment.
DEVELOPER_USERNAME=developer
DEVELOPER_PIN=replace_with_your_own_6_to_10_digit_pin

# How long a login session stays valid before the user has to log in again.
JWT_EXPIRES_IN=8h

# Port the API server listens on. Railway sets this automatically - you don't
# need to set it yourself in production.
PORT=4000

# Which frontend origin(s) are allowed to call this API (CORS).
# For local dev, this can be "*". In production, set it to your real domain,
# e.g. https://app.grvscanner.co.za
ALLOWED_ORIGIN=*

# Where GRV-Scanner-App.html lives, so this server can serve it directly
# alongside the API (backend + frontend in one Railway service). Leave blank
# to look for it in this same folder - which is where it should be if you
# copied it in per the README.
FRONTEND_DIR=

# ── Paystack (real billing) ──
# Get your secret key from your Paystack dashboard > Settings > API Keys & Webhooks.
# Use a test key (starts with sk_test_) while developing, live key (sk_live_) once ready.
# Leave blank to run the app without real billing - Billing page will show a
# clear "not connected" message instead of accepting real payment.
PAYSTACK_SECRET_KEY=

# Create a Plan for each tier in your Paystack dashboard (Plans tab), then paste
# each plan's code (e.g. PLN_xxxxxxxx) here. The price you set on the Paystack
# plan itself is what actually gets charged - keep it in sync with what the
# app displays (see PLAN_CONFIG in routes/billing.js).
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PROFESSIONAL=
PAYSTACK_PLAN_ENTERPRISE=

# Where Paystack redirects the admin back to after checkout. Should be the
# URL where this app's HTML file is actually being served from.
PAYSTACK_CALLBACK_URL=http://localhost:3000
